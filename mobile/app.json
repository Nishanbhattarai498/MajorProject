{
  "expo": {
    "name": "NeuroScope",
    "slug": "neuroscope-brain-mri",
    "scheme": "neuroscope",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "sdkVersion": "57.0.0",
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow NeuroScope to select an MRI image for analysis.",
          "cameraPermission": false
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {}
  }
}
